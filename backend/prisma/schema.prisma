generator client {
  provider = "prisma-client-js"
  // « native » couvre la machine de développement (Windows), la cible Debian
  // couvre l'image de production. Sans elle, le moteur généré peut ne pas
  // correspondre à celui attendu dans le conteneur.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id                String   @id @default(uuid())
  nom               String
  adressePhysique   String?
  ville             String?
  pays              String?
  siteWeb           String?
  emailContact      String?
  nomContactInterne String?
  commercialEnCharge String?
  secteurActivite   String?
  chiffreAffaires   Decimal? @db.Decimal(18, 2)
  telephone         String?
  notes             String?
  champsPersonnalises Json?  @default("{}")
  importJob         ImportJob? @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  importJobId       String?

  /// Compte qui a créé la fiche. Un commercial voit toujours ses propres
  /// prospects. Le champ texte « commercialEnCharge » reste, lui, purement
  /// informatif : il provient des fichiers importés.
  proprietaire   Utilisateur? @relation("Proprietaire", fields: [proprietaireId], references: [id], onDelete: SetNull)
  proprietaireId String?
  acces          AccesClient[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([proprietaireId])
  @@index([pays])
  @@index([ville])
  @@index([secteurActivite])
  @@index([commercialEnCharge])
  @@index([importJobId])
}

model ImportJob {
  id           String   @id @default(uuid())
  nomFichier   String
  formatSource String
  nbLignesTotal Int
  nbLignesImportees Int
  nbErreurs    Int
  mappingUtilise Json
  erreurs      Json?
  createdAt    DateTime @default(now())
  clients      Client[]
}

/// Hiérarchie de privilèges. Les capacités réelles de chaque rôle sont
/// définies dans src/lib/permissions.ts, pas ici.
enum RoleUtilisateur {
  SUPER_ADMIN
  ADMIN
  RESPONSABLE_COMMERCIAL
  COMMERCIAL
  COMPTABLE
  CHEF_DE_PROJET
}

model Utilisateur {
  id             String          @id @default(uuid())
  identifiant    String          @unique
  nomComplet     String
  email          String?
  fonction       String?
  motDePasseHash String
  role           RoleUtilisateur @default(COMMERCIAL)
  actif          Boolean         @default(true)
  dernierAcces   DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  /// Responsable hiérarchique : un responsable commercial n'administre que
  /// les comptes qui lui sont rattachés.
  responsable   Utilisateur?  @relation("Equipe", fields: [responsableId], references: [id], onDelete: SetNull)
  responsableId String?
  equipe        Utilisateur[] @relation("Equipe")

  clientsPossedes Client[]      @relation("Proprietaire")
  accesAccordes   AccesClient[] @relation("Beneficiaire")

  @@index([responsableId])
}

/// Surcharge de la matrice de permissions pour un rôle. Absent = le rôle
/// utilise les valeurs par défaut définies dans src/lib/permissions.ts.
/// SUPER_ADMIN n'y figure jamais : ses droits ne sont pas modifiables, faute
/// de quoi il serait possible de se verrouiller hors de l'application.
model PermissionsRole {
  role        RoleUtilisateur @id
  permissions String[]
  modifiePar  String?
  updatedAt   DateTime        @updatedAt
}

/// Accès nominatif d'un utilisateur à un client précis, ouvert par un
/// responsable. C'est ce qui permet à un commercial de voir une fiche qui
/// ne lui appartient pas, sans lui ouvrir toute la base.
model AccesClient {
  id            String      @id @default(uuid())
  client        Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId      String
  utilisateur   Utilisateur @relation("Beneficiaire", fields: [utilisateurId], references: [id], onDelete: Cascade)
  utilisateurId String
  /// Simple trace d'audit : volontairement sans clé étrangère, pour qu'un
  /// compte supprimé n'efface pas l'historique des accès qu'il a ouverts.
  accordeParId  String
  accordeParNom String
  createdAt     DateTime    @default(now())

  @@unique([clientId, utilisateurId])
  @@index([utilisateurId])
}

enum NewsletterStatut {
  BROUILLON
  ENVOI_EN_COURS
  ENVOYEE
  ECHEC
}

enum NewsletterFormat {
  TEXTE
  HTML
}

model Newsletter {
  id              String   @id @default(uuid())
  titre           String
  sujet           String
  format          NewsletterFormat @default(TEXTE)
  contenu         String
  secteursCibles  String[]
  statut          NewsletterStatut @default(BROUILLON)
  nbDestinataires Int?
  nbEnvoyes       Int?
  nbEchecs        Int?
  envoyeeLe       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  envois          NewsletterEnvoi[]
}

enum EnvoiStatut {
  ENVOYE
  ECHEC
}

model NewsletterEnvoi {
  id            String   @id @default(uuid())
  newsletter    Newsletter @relation(fields: [newsletterId], references: [id], onDelete: Cascade)
  newsletterId  String
  clientId      String
  clientNom     String
  email         String
  statut        EnvoiStatut
  erreur        String?
  createdAt     DateTime @default(now())

  @@index([newsletterId])
}
