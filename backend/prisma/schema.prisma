generator client {
  provider = "prisma-client-js"
  // « native » couvre la machine de développement (Windows), la cible Debian
  // couvre l'image de production. Sans elle, le moteur généré peut ne pas
  // correspondre à celui attendu dans le conteneur.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id                String   @id @default(uuid())
  nom               String
  adressePhysique   String?
  ville             String?
  pays              String?
  siteWeb           String?
  emailContact      String?
  nomContactInterne String?
  commercialEnCharge String?
  secteurActivite   String?
  chiffreAffaires   Decimal? @db.Decimal(18, 2)
  telephone         String?
  notes             String?
  champsPersonnalises Json?  @default("{}")
  importJob         ImportJob? @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  importJobId       String?

  /// Compte qui a créé la fiche. Un commercial voit toujours ses propres
  /// prospects. Le champ texte « commercialEnCharge » reste, lui, purement
  /// informatif : il provient des fichiers importés.
  proprietaire   Utilisateur? @relation("Proprietaire", fields: [proprietaireId], references: [id], onDelete: SetNull)
  proprietaireId String?
  acces          AccesClient[]
  ventes         Vente[]
  projets        Projet[]
  saisiesTemps   SaisieTemps[]
  /// « notes » est déjà pris par le champ texte libre de la fiche, plus haut.
  pensesBetes    Note[]
  opportunites   Opportunite[]
  cotations      DemandeCotation[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([proprietaireId])
  @@index([pays])
  @@index([ville])
  @@index([secteurActivite])
  @@index([commercialEnCharge])
  @@index([importJobId])
}

model ImportJob {
  id           String   @id @default(uuid())
  nomFichier   String
  formatSource String
  nbLignesTotal Int
  nbLignesImportees Int
  nbErreurs    Int
  mappingUtilise Json
  erreurs      Json?
  createdAt    DateTime @default(now())
  clients      Client[]
}

/// Hiérarchie de privilèges. Les capacités réelles de chaque rôle sont
/// définies dans src/lib/permissions.ts, pas ici.
enum RoleUtilisateur {
  SUPER_ADMIN
  ADMIN
  DG
  RESPONSABLE_COMMERCIAL
  COMMERCIAL
  COMPTABLE
  CHEF_DE_PROJET

  /// Ressources humaines. Tient l'effectif, les contrats et les congés, et ne
  /// voit du commercial que ce que tout le monde voit.
  RH
}

model Utilisateur {
  id             String          @id @default(uuid())
  identifiant    String          @unique
  nomComplet     String
  email          String?
  fonction       String?
  motDePasseHash String

  /// Pays de rattachement du commercial, son territoire.
  ///
  /// Distinct du pays de ses clients : un commercial basé au Cameroun peut
  /// vendre au Kenya. C'est bien son affectation qui est filtrée dans la vue
  /// Équipe commerciale, pas la provenance de ses ventes.
  pays String?

  /// Taux de commission NÉGOCIÉ pour ce compte, en pourcentage (12.5 = 12,5 %).
  ///
  /// Appliqué au BÉNÉFICE et non au chiffre d'affaires : c'est la marge qui
  /// rémunère l'entreprise, et commissionner sur le chiffre d'affaires
  /// récompenserait une vente à perte. Voir « commissionDe » dans
  /// src/lib/commissions.ts, seul endroit où cette règle est écrite.
  ///
  /// Null dans le cas courant, et c'est alors le barème maison qui s'applique :
  /// 3 % sur le matériel, 5 % sur le service (BAREME_PCT dans le même fichier).
  /// Renseignée, la valeur REMPLACE le barème pour les deux natures, un accord
  /// particulier se signant sur un chiffre unique.
  ///
  /// La colonne reste nullable à dessein : « rien de négocié » et « 3 %
  /// explicitement accordés » ne se confondent pas, et une valeur copiée dans
  /// chaque ligne figerait le barème au jour de la création du compte.
  tauxCommissionPct Decimal? @db.Decimal(5, 2)
  role           RoleUtilisateur @default(COMMERCIAL)
  actif          Boolean         @default(true)
  dernierAcces   DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  /// Responsable hiérarchique : un responsable commercial n'administre que
  /// les comptes qui lui sont rattachés.
  responsable   Utilisateur?  @relation("Equipe", fields: [responsableId], references: [id], onDelete: SetNull)
  responsableId String?
  equipe        Utilisateur[] @relation("Equipe")

  /// Vrai quand le compte pilote son suivi sur ses propres objectifs plutôt
  /// que sur ceux fixés par son responsable. Les deux jeux restent en base :
  /// basculer ne détruit rien, et on peut revenir.
  objectifsPersonnels Boolean @default(false)

  /// Dossier du personnel, quand ce compte appartient à un employé.
  ///
  /// Facultatif dans les deux sens : un prestataire ou un compte technique n'a
  /// pas de dossier RH, et la plupart des employés n'ont pas de compte.
  employe         Employe?

  saisiesTemps    SaisieTemps[]        @relation("Temps")
  notesPosees     Note[]               @relation("Notes")
  opportunites    Opportunite[]        @relation("Opportunites")
  objectifs       ObjectifCommercial[] @relation("Objectifs")

  /// Les deux bouts du circuit de cotation : ce compte en demande, ou il en
  /// traite. Deux relations distinctes parce qu'un même compte peut faire les
  /// deux, et qu'on veut pouvoir lire chaque file séparément.
  cotationsDemandees DemandeCotation[] @relation("CotationsDemandees")
  cotationsTraitees  DemandeCotation[] @relation("CotationsTraitees")

  clientsPossedes Client[]      @relation("Proprietaire")
  accesAccordes   AccesClient[] @relation("Beneficiaire")
  ventes          Vente[]       @relation("Vendeur")
  projets         Projet[]      @relation("ChefDeProjet")

  @@index([responsableId])
}

/// Une vente réalisée : c'est la seule source des indicateurs de direction.
///
/// Le champ « chiffreAffaires » porté par Client est un montant global saisi
/// à la main lors des imports ; il ne dit ni quand, ni par qui, ni sur quoi.
/// Les quatre indicateurs du tableau de bord du DG (chiffre d'affaires,
/// meilleur vendeur, meilleur produit, bénéfice moyen) se calculent tous ici.
///
/// Les prix sont unitaires et hors taxes, en XAF, comme le reste de l'outil.
model Vente {
  id        String @id @default(uuid())

  /// La fiche client peut disparaître (suppression d'un fichier importé)
  /// sans que la vente ne s'efface : le nom en garde la trace lisible.
  client    Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId  String?
  clientNom String

  /// Idem pour le vendeur : un compte fermé ne doit pas retirer sa
  /// contribution du chiffre d'affaires déjà réalisé.
  vendeur    Utilisateur? @relation("Vendeur", fields: [vendeurId], references: [id], onDelete: SetNull)
  vendeurId  String?
  vendeurNom String

  /// Produit ou service vendu. Texte libre volontairement : le catalogue
  /// d'EasyTech n'est pas encore modélisé, et l'imposer maintenant figerait
  /// des choix qui n'ont pas été arbitrés.
  produit  String
  quantite Int @default(1)

  /// Matériel ou service. C'est cette nature, et elle seule, qui fixe le taux
  /// de commission (voir src/lib/commissions.ts) : le libellé du produit reste
  /// du texte libre et ne peut donc pas porter une règle de rémunération.
  ///
  /// Le défaut est MATERIEL parce qu'il commissionne au taux le plus bas :
  /// une vente mal qualifiée ne doit pas verser plus que dû.
  nature NatureVente @default(MATERIEL)

  /// Prix unitaire facturé au client. Toujours connu : c'est ce que porte le
  /// document validé dans Zoho, et donc ce que saisit le commercial.
  prixVente Decimal @db.Decimal(18, 2)

  /// Coût unitaire d'acquisition. NULL tant que personne ne l'a renseigné.
  ///
  /// Chez EasyTech le commercial ne le connaît pas : il vend sur la base d'un
  /// devis Zoho, et seule la direction dispose du prix d'achat réel. Exiger
  /// un chiffre à la saisie ne produirait donc pas une marge juste, mais un
  /// nombre inventé pour que le formulaire accepte d'être validé.
  ///
  /// Tant qu'il manque, la vente compte dans le chiffre d'affaires et dans les
  /// objectifs, mais reste hors de tout calcul de marge et de commission : une
  /// marge inconnue vaut mieux qu'une marge fausse.
  prixAchat Decimal? @db.Decimal(18, 2)

  /// Qui a renseigné le coût, et quand. Le coût décide de la commission de
  /// quelqu'un d'autre : il doit être attribuable sans aller lire un journal.
  coutSaisiParNom String?
  coutSaisiLe     DateTime?

  /// Référence du document validé dans Zoho (devis accepté, bon de commande
  /// ou facture selon le circuit).
  ///
  /// C'est la clé de rapprochement avec l'extérieur. Sans elle, le jour où une
  /// synchronisation automatique arrivera, elle recréerait ce qui est déjà en
  /// base et gonflerait le chiffre d'affaires en silence. Les lignes d'un même
  /// document partagent la même référence, ce qui suffit à les regrouper sans
  /// modéliser une entité « commande » séparée.
  referenceCommande String?

  dateVente DateTime @default(now())

  /// Date de versement de la commission due sur cette vente.
  ///
  /// Null tant que rien n'a été versé. La commission se calcule toujours à la
  /// volée depuis le bénéfice et le taux (voir src/lib/commissions.ts) : ne
  /// stocker que la DATE évite qu'un montant figé contredise un taux corrigé
  /// plus tard. C'est ce champ, et lui seul, qui sépare le « reçu » de
  /// l'« attendu » sur le tableau de bord du commercial.
  commissionVerseeLe DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Vente issue du jeu de démonstration.
  ///
  /// Sans ce drapeau, le nettoyage en production dépendrait des comptes qui
  /// ont porté ces ventes : si l'un d'eux est supprimé à la main, la relation
  /// passe à null et la vente devient introuvable, tout en continuant de
  /// gonfler le chiffre d'affaires. Le drapeau rend la suppression sûre et
  /// vérifiable, indépendamment de ce qui est arrivé aux comptes.
  estDemo Boolean @default(false)

  /// Projet de livraison né de cette vente, quand elle porte une prestation.
  projets Projet[]

  @@index([estDemo])
  @@index([vendeurId])
  @@index([clientId])
  @@index([produit])
  @@index([dateVente])
  @@index([referenceCommande])
}

/// Nature de ce qui est vendu.
///
/// Deux valeurs et pas davantage : c'est une grille de commissionnement, pas
/// un catalogue. Le matériel se revend avec une marge faible et un travail
/// de vente court ; le service engage le commercial bien au-delà de la
/// signature, et EasyTech le rémunère en conséquence.
enum NatureVente {
  /// Équipements et consommables revendus en l'état.
  MATERIEL

  /// Prestations, licences, abonnements, développement : tout l'immatériel.
  SERVICE
}

/// Surcharge de la matrice de permissions pour un rôle. Absent = le rôle
/// utilise les valeurs par défaut définies dans src/lib/permissions.ts.
/// SUPER_ADMIN n'y figure jamais : ses droits ne sont pas modifiables, faute
/// de quoi il serait possible de se verrouiller hors de l'application.
model PermissionsRole {
  role        RoleUtilisateur @id
  permissions String[]
  modifiePar  String?
  updatedAt   DateTime        @updatedAt
}

/// Accès nominatif d'un utilisateur à un client précis, ouvert par un
/// responsable. C'est ce qui permet à un commercial de voir une fiche qui
/// ne lui appartient pas, sans lui ouvrir toute la base.
model AccesClient {
  id            String      @id @default(uuid())
  client        Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId      String
  utilisateur   Utilisateur @relation("Beneficiaire", fields: [utilisateurId], references: [id], onDelete: Cascade)
  utilisateurId String
  /// Simple trace d'audit : volontairement sans clé étrangère, pour qu'un
  /// compte supprimé n'efface pas l'historique des accès qu'il a ouverts.
  accordeParId  String
  accordeParNom String
  createdAt     DateTime    @default(now())

  @@unique([clientId, utilisateurId])
  @@index([utilisateurId])
}

enum NewsletterStatut {
  BROUILLON
  ENVOI_EN_COURS
  ENVOYEE
  ECHEC
}

enum NewsletterFormat {
  TEXTE
  HTML
}

model Newsletter {
  id              String   @id @default(uuid())
  titre           String
  sujet           String
  format          NewsletterFormat @default(TEXTE)
  contenu         String
  secteursCibles  String[]
  statut          NewsletterStatut @default(BROUILLON)
  nbDestinataires Int?
  nbEnvoyes       Int?
  nbEchecs        Int?
  envoyeeLe       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  envois          NewsletterEnvoi[]
}

enum EnvoiStatut {
  ENVOYE
  ECHEC
}

model NewsletterEnvoi {
  id            String   @id @default(uuid())
  newsletter    Newsletter @relation(fields: [newsletterId], references: [id], onDelete: Cascade)
  newsletterId  String
  clientId      String
  clientNom     String
  email         String
  statut        EnvoiStatut
  erreur        String?
  createdAt     DateTime @default(now())

  @@index([newsletterId])
}

/// État d'avancement d'un projet, du plus amont au plus aval.
enum StatutProjet {
  EN_PREPARATION
  EN_COURS
  EN_PAUSE
  LIVRE
  ANNULE
}

/// Projet de livraison confié à l'équipe projet.
///
/// Un projet naît d'une vente : le commercial vend une prestation, l'équipe
/// projet la livre. Le lien vers la vente est donc la règle, pas l'exception,
/// et c'est lui qui rend comparables le chiffre d'affaires signé et ce qui est
/// réellement livré.
///
/// Toutes les ventes n'engendrent pas de projet : des licences se livrent sans
/// chantier. Seules les prestations en déclenchent un.
model Projet {
  id  String @id @default(uuid())
  nom String

  /// Comme pour les ventes, le nom double la relation : supprimer une fiche
  /// client ne doit pas effacer la trace de ce qui lui a été livré.
  client    Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId  String?
  clientNom String

  /// Vente d'origine. Absente pour un projet interne ou repris hors CRM.
  vente   Vente?  @relation(fields: [venteId], references: [id], onDelete: SetNull)
  venteId String?

  chefDeProjet   Utilisateur? @relation("ChefDeProjet", fields: [chefDeProjetId], references: [id], onDelete: SetNull)
  chefDeProjetId String?
  chefDeProjetNom String

  statut StatutProjet @default(EN_PREPARATION)

  /// Montant confié à l'équipe projet, en XAF. Repris de la vente quand le
  /// projet en découle.
  budget Decimal @db.Decimal(18, 2)

  /// Avancement déclaré, de 0 à 100. Un projet livré vaut 100 par
  /// construction ; c'est vérifié à l'écriture, pas seulement à l'affichage.
  avancementPct Int @default(0)

  dateDebut     DateTime
  dateFinPrevue DateTime
  /// Renseignée à la livraison. Sa comparaison à « dateFinPrevue » donne le
  /// respect des délais, seul indicateur de tenue d'engagement dont on dispose.
  dateFinReelle DateTime?

  /// Même rôle que sur Vente : rendre le nettoyage de production sûr et
  /// vérifiable, indépendamment des comptes qui portent ces projets.
  estDemo Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([estDemo])
  @@index([chefDeProjetId])
  @@index([clientId])
  @@index([statut])
  @@index([dateFinPrevue])
}

/// Un créneau est-il prévu, ou constaté ?
///
/// La distinction porte tout l'agenda : un rendez-vous de mardi prochain et
/// une heure de prospection d'hier ne disent pas la même chose, et les
/// additionner donnerait une feuille de temps qui déclare du travail non
/// encore fait. Seuls les créneaux RÉALISÉ comptent dans les totaux.
enum StatutCreneau {
  PREVU
  REALISE
}

/// Un créneau de travail déclaré par un commercial.
///
/// Les heures sont stockées en minutes depuis minuit plutôt qu'en DateTime :
/// un créneau est une position dans la journée, pas un instant universel, et
/// un fuseau horaire appliqué à « 09:00 » le déplacerait d'une heure selon le
/// serveur qui le relit.
model SaisieTemps {
  id String @id @default(uuid())

  utilisateur   Utilisateur @relation("Temps", fields: [utilisateurId], references: [id], onDelete: Cascade)
  utilisateurId String

  /// Jour concerné, à minuit heure locale.
  jour DateTime @db.Date

  /// Minutes depuis minuit. 540 = 09:00, 1020 = 17:00.
  debutMinutes Int
  finMinutes   Int

  /// Ce qui a été fait, en toutes lettres.
  ///
  /// Texte libre et non liste fermée : une nomenclature d'activités imposée
  /// oblige à ranger « réunion de cadrage chez le client » dans une case qui
  /// ne lui va pas, et une feuille de temps qu'on remplit de travers n'est
  /// pas lue. Les libellés déjà employés sont reproposés à la saisie, ce qui
  /// suffit à garder les statistiques regroupées sans rien interdire.
  activite String

  /// Précision libre, quand le libellé ne dit pas tout.
  description String?

  /// Prévu tant qu'il n'a pas eu lieu, réalisé une fois constaté. Un créneau
  /// posé sur un jour à venir naît PREVU ; celui qu'on déclare après coup
  /// naît REALISE. Le passage de l'un à l'autre est un geste explicite :
  /// basculer automatiquement à la date dirait que le rendez-vous a eu lieu
  /// alors qu'il a pu être annulé.
  statut StatutCreneau @default(REALISE)

  /// Client concerné, quand l'activité en vise un. Le nom double la relation
  /// pour que la feuille reste lisible après suppression d'une fiche.
  client    Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId  String?
  clientNom String?

  estDemo Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([utilisateurId, jour])
  @@index([estDemo])
}

/// Note libre posée sur une journée, façon pense-bête.
///
/// Elle ne mesure rien et n'entre dans aucun total : c'est ce qu'un
/// commercial griffonne en marge de sa feuille de temps et qui décide d'une
/// vente trois semaines plus tard. « Le DAF veut une remise avant de
/// signer », « rappeler après le conseil d'administration du 12 » : rien de
/// tout cela n'a sa place dans un créneau horaire, et tout se perd si l'outil
/// n'offre pas où l'écrire.
///
/// Distincte de « SaisieTemps.description », qui précise une activité
/// déclarée : une note n'a ni horaire ni durée, et survit à la journée où
/// elle a été posée quand elle est épinglée.
model Note {
  id String @id @default(uuid())

  utilisateur   Utilisateur @relation("Notes", fields: [utilisateurId], references: [id], onDelete: Cascade)
  utilisateurId String

  /// Jour où la note a été posée, à minuit UTC comme les créneaux.
  jour DateTime @db.Date

  texte String

  /// Teinte du papier, choisie par l'auteur. Elle ne code rien : chacun range
  /// ses notes comme il l'entend, et imposer une signification aux couleurs
  /// reviendrait à recréer la nomenclature dont on vient de se défaire.
  couleur String @default("JAUNE")

  /// Épinglée, la note reste visible sur toutes les journées jusqu'à ce qu'on
  /// la décroche. C'est ce qui permet de suivre un point ouvert tout au long
  /// d'un cycle de vente, au lieu de le retrouver au jour où on l'a écrit.
  epinglee Boolean @default(false)

  /// Client concerné, quand la note en vise un. Le nom double la relation
  /// pour que la note reste lisible après suppression d'une fiche.
  client    Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId  String?
  clientNom String?

  estDemo Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([utilisateurId, jour])
  @@index([utilisateurId, epinglee])
  @@index([clientId])
  @@index([estDemo])
}

/// Granularité d'un objectif commercial.
enum PeriodeObjectif {
  JOUR
  SEMAINE
  MOIS
  TRIMESTRE
  SEMESTRE
  ANNEE
}

/// Objectif chiffré assigné à un commercial sur une période.
///
/// Deux origines possibles : fixé par le responsable commercial, ou défini par
/// l'intéressé. Les deux coexistent en base, et c'est une préférence du compte
/// (« objectifsPersonnels ») qui décide lesquels pilotent son suivi. Effacer
/// les objectifs du responsable quand quelqu'un passe en libre lui ferait
/// perdre sa feuille de route s'il revient dessus.
model ObjectifCommercial {
  id String @id @default(uuid())

  utilisateur   Utilisateur @relation("Objectifs", fields: [utilisateurId], references: [id], onDelete: Cascade)
  utilisateurId String

  /// Intitulé court, comme un nom de chantier. Un objectif qui ne s'appelle
  /// que « mois d'octobre » ne se cite pas en réunion et ne se retient pas.
  titre String?

  /// Ce qu'il recouvre : marché visé, moyens convenus, contrepartie. C'est la
  /// partie qui se relit six mois plus tard, quand plus personne ne se
  /// souvient du contexte de l'engagement.
  description String?

  periode   PeriodeObjectif
  /// Début de la fenêtre, à minuit heure locale. La fin se déduit de la
  /// période : la stocker ouvrirait la porte à une incohérence entre les deux.
  debut DateTime @db.Date

  /// Chiffre d'affaires visé, en XAF. Null quand l'objectif ne porte que sur
  /// l'activité (nombre de rendez-vous, par exemple).
  cibleCaXAF Decimal? @db.Decimal(18, 2)
  cibleVentes Int?
  cibleRendezVous Int?

  /// Vrai quand l'objectif vient de l'encadrement. L'intéressé ne peut alors
  /// ni le modifier ni le supprimer : un objectif qu'on peut réécrire soi-même
  /// n'engage personne.
  fixeParEncadrement Boolean @default(false)
  /// Trace de l'auteur, sans clé étrangère : un compte fermé ne doit pas
  /// effacer l'origine d'un engagement.
  definiParNom String

  note String?

  estDemo Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jalons JalonObjectif[]

  /// Un seul objectif par personne, période et fenêtre, quelle que soit son
  /// origine : deux chiffres pour le même mois ne se départagent pas.
  @@unique([utilisateurId, periode, debut, fixeParEncadrement])
  @@index([utilisateurId, periode])
  @@index([debut])
  @@index([estDemo])
}

/// Unité d'un jalon, qui dit comment son avancement se lit.
enum UniteJalon {
  /// Montant en XAF, comparé au chiffre d'affaires réalisé.
  MONTANT
  /// Un décompte : nombre de rendez-vous, de devis, de certifications.
  NOMBRE
  /// Fait ou pas fait. Le seul cas où l'avancement n'a pas de fraction.
  BINAIRE
}

/// Étape mesurable d'un objectif, à la façon d'un jalon de projet.
///
/// Un objectif réduit à un montant annuel ne se pilote pas : on ne sait ni
/// par où commencer, ni si l'on dérive avant la clôture. Le découper en
/// jalons datés et chiffrés rend l'engagement vérifiable en cours de route,
/// et c'est là que se tient la conversation avec l'encadrement.
///
/// L'avancement est déclaré et non calculé : un jalon porte souvent sur ce
/// que le CRM ne mesure pas (une certification obtenue, un partenariat signé,
/// un territoire ouvert). Ceux qui portent sur le chiffre d'affaires sont
/// doublés par l'objectif lui-même, qui lui se mesure sur les ventes.
model JalonObjectif {
  id String @id @default(uuid())

  objectif   ObjectifCommercial @relation(fields: [objectifId], references: [id], onDelete: Cascade)
  objectifId String

  libelle String
  unite   UniteJalon @default(NOMBRE)

  /// Cible et avancement déclaré. Pour un jalon BINAIRE, 0 ou 1.
  cible   Decimal @db.Decimal(18, 2)
  realise Decimal @default(0) @db.Decimal(18, 2)

  /// Échéance intermédiaire, toujours dans la fenêtre de l'objectif. Sans
  /// date, un jalon se repousse indéfiniment et cesse d'être un jalon.
  echeance DateTime @db.Date

  ordre Int @default(0)

  estDemo Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([objectifId])
  @@index([estDemo])
}

/// Nature du partenariat, qui dit ce qu'on attend de l'autre.
enum TypePartenaire {
  EDITEUR
  CONSTRUCTEUR
  DISTRIBUTEUR
  SERVICES
}

/// Partenaire technologique.
///
/// Le programme de chaque éditeur a sa propre échelle : Microsoft parle de
/// Silver et Gold, Fortinet de Select, Advanced et Expert. « paliers » porte
/// donc l'échelle complète du programme, dans l'ordre, plutôt qu'une énumération
/// commune qui ne conviendrait à personne.
model Partenaire {
  id      String         @id @default(uuid())
  nom     String         @unique
  type    TypePartenaire
  siteWeb String?

  /// Échelle du programme, du palier le plus bas au plus haut.
  paliers      String[]
  niveauActuel String
  /// Date d'obtention du palier courant, quand elle est connue.
  depuis DateTime?

  /// Mots-clés des produits vendus sous ce partenariat.
  ///
  /// C'est ce qui relie le partenaire aux ventes déjà en base : un palier se
  /// gagne au volume, et sans ce lien les conditions de chiffre d'affaires
  /// resteraient déclaratives au lieu d'être mesurées.
  motsClesProduits String[]

  /// Interlocuteur chez le partenaire. Le champ existe même vide : ne pas
  /// savoir qui appeler est en soi une information.
  channelManagerNom       String?
  channelManagerEmail     String?
  channelManagerTelephone String?

  notes   String?
  estDemo Boolean @default(false)

  conditions ConditionPartenariat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([estDemo])
}

/// Une exigence à remplir pour accéder au palier suivant.
///
/// L'exigence et la situation sont du texte : les unités n'ont rien de commun
/// d'une ligne à l'autre (un montant, un nombre d'ingénieurs certifiés, des
/// références clients). Imposer un nombre obligerait à choisir une unité, donc
/// à fausser les autres. « satisfaite » porte le verdict, seul élément commun.
model ConditionPartenariat {
  id           String     @id @default(uuid())
  partenaire   Partenaire @relation(fields: [partenaireId], references: [id], onDelete: Cascade)
  partenaireId String

  libelle   String
  exigence  String
  /// Où l'on en est. Null quand la mesure n'est pas connue, ce qui n'est pas
  /// la même chose qu'une condition non remplie.
  situation String?

  /// Seuil de chiffre d'affaires, quand la condition en est un.
  ///
  /// Renseigné, il rend la condition MESURÉE : son verdict se calcule sur les
  /// ventes réelles des produits du partenaire, et « satisfaite » n'est plus lu.
  /// Sans cela, une condition de volume resterait cochée à la main et pourrait
  /// contredire le chiffre affiché juste au-dessus.
  seuilCaXAF Decimal? @db.Decimal(18, 2)

  /// Verdict saisi, pour les conditions qu'aucun chiffre du CRM ne mesure
  /// (certifications, audits, engagements contractuels).
  satisfaite Boolean @default(false)
  ordre      Int     @default(0)

  @@index([partenaireId])
}

/// Nature de la campagne.
///
/// Le mailing est ponctuel et vise une liste apportée ; la newsletter est
/// périodique. La distinction reste éditoriale, la mécanique d'envoi étant la
/// même : c'est ce qui permet de n'avoir qu'un modèle.
enum TypeCampagne {
  MAILING
  NEWSLETTER
}

enum StatutCampagne {
  BROUILLON
  PRETE
  ENVOYEE
  ECHEC
}

/// Campagne d'emailing adressée à une liste importée.
///
/// À distinguer du modèle Newsletter, plus ancien, qui cible les clients du CRM
/// par secteur. Ici les destinataires viennent d'un fichier fourni, ce qui
/// couvre les envois vers des contacts qui ne sont pas encore clients.
model Campagne {
  id    String       @id @default(uuid())
  type  TypeCampagne
  titre String
  objet String

  /// Contenu au format HTML, images comprises. Voir la note sur le stockage
  /// des images dans le composant d'édition côté interface.
  contenuHtml String @default("")

  statut StatutCampagne @default(BROUILLON)

  /// Nom du fichier d'où vient la liste, pour retrouver l'origine d'un envoi.
  fichierSource String?

  /// Trace de l'auteur sans clé étrangère : un compte fermé ne doit pas
  /// effacer l'historique des campagnes qu'il a écrites.
  creeParId  String?
  creeParNom String

  envoyeeLe DateTime?
  estDemo   Boolean   @default(false)

  destinataires CampagneDestinataire[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([statut])
  @@index([estDemo])
}

/// Un destinataire d'une campagne, issu de la liste importée.
model CampagneDestinataire {
  id         String   @id @default(uuid())
  campagne   Campagne @relation(fields: [campagneId], references: [id], onDelete: Cascade)
  campagneId String

  email String
  nom   String?

  createdAt DateTime @default(now())

  /// Une même adresse ne peut figurer deux fois dans la même campagne :
  /// le dédoublonnage est garanti par la base, pas seulement par l'import.
  @@unique([campagneId, email])
  @@index([campagneId])
}


// ==========================================================================
// Ressources humaines
// ==========================================================================

/// Situation d'une personne dans l'entreprise.
enum StatutEmploye {
  /// En poste.
  ACTIF

  /// Présent à l'effectif mais momentanément écarté : suspension, congé sans
  /// solde de longue durée, détachement. Ne disparaît pas des listes, mais ne
  /// compte pas dans l'effectif présent.
  SUSPENDU

  /// Parti. La fiche reste : un dossier du personnel se conserve, et les
  /// congés pris ou les éléments de paie d'un ancien salarié restent à justifier.
  SORTI
}

/// Une personne employée, qu'elle ait un accès à l'application ou non.
///
/// C'est le pivot du module RH, et il est distinct d'« Utilisateur » à dessein.
/// Un chauffeur, un agent de sécurité ou un technicien de terrain n'ont aucune
/// raison de se connecter, et doivent pourtant figurer à l'effectif et poser
/// des congés. À l'inverse, un compte peut exister sans personne derrière lui.
/// Fondre les deux obligerait à ouvrir un compte à chacun, avec les accès que
/// cela suppose, ou à laisser la moitié du personnel hors de la RH.
model Employe {
  id String @id @default(uuid())

  /// Identifiant interne du dossier. Unique, et saisi par la RH : c'est lui
  /// qui figure sur les bulletins et les courriers, l'outil ne l'invente pas.
  matricule String @unique

  nom     String
  prenoms String?

  /// Coordonnées personnelles, distinctes de l'adresse professionnelle du
  /// compte : on écrit à un salarié en congé sur son adresse à lui.
  emailPersonnel String?
  telephone      String?
  adresse        String?
  dateNaissance  DateTime? @db.Date
  lieuNaissance  String?

  /// Numéro d'assuré social, pour les déclarations.
  numeroCnps String?

  /// Intitulé du poste et service de rattachement, en texte libre.
  ///
  /// Même choix que pour les activités des feuilles de temps : une
  /// nomenclature fermée oblige à ranger un poste réel dans une case qui ne
  /// lui va pas. Les valeurs déjà employées sont reproposées à la saisie, ce
  /// qui suffit à garder l'organigramme cohérent sans rien interdire.
  poste   String?
  service String?

  /// Responsable hiérarchique, au sens RH.
  ///
  /// Distinct de la hiérarchie commerciale portée par Utilisateur.responsable :
  /// l'une dit qui voit le portefeuille de qui, l'autre qui valide le congé de
  /// qui. Les confondre se paie le jour où un commercial change de responsable
  /// commercial sans changer de manager.
  manager   Employe?  @relation("Hierarchie", fields: [managerId], references: [id], onDelete: SetNull)
  managerId String?
  subordonnes Employe[] @relation("Hierarchie")

  dateEmbauche DateTime  @db.Date
  statut       StatutEmploye @default(ACTIF)
  dateSortie   DateTime? @db.Date
  motifSortie  String?

  /// Compte de connexion, s'il en a un. Un à un : deux dossiers ne peuvent pas
  /// pointer vers la même personne connectée.
  utilisateur   Utilisateur? @relation(fields: [utilisateurId], references: [id], onDelete: SetNull)
  utilisateurId String?      @unique

  contrats  Contrat[]
  absences  DemandeAbsence[]  @relation("Demandeur")
  ajustements AjustementConge[]

  estDemo Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([statut])
  @@index([managerId])
  @@index([estDemo])
  @@index([nom])
}

/// Nature juridique d'un engagement.
enum TypeContrat {
  CDI
  CDD
  STAGE
  PRESTATION
  INTERIM
}

/// Un engagement contractuel, passé ou en cours.
///
/// Un employé en a plusieurs dans le temps : un stage puis un CDD puis un CDI,
/// ou des avenants successifs. On ne remplace donc jamais le contrat en place,
/// on en ouvre un nouveau : l'historique est ce qui permet de prouver une
/// ancienneté et de répondre à un contrôle.
model Contrat {
  id String @id @default(uuid())

  employe   Employe @relation(fields: [employeId], references: [id], onDelete: Cascade)
  employeId String

  type      TypeContrat
  intitule  String?
  debut     DateTime  @db.Date

  /// Nul pour un CDI. Rempli, il déclenche l'alerte d'échéance : un CDD qui
  /// se poursuit sans renouvellement écrit se requalifie.
  fin       DateTime? @db.Date

  /// Fin de la période d'essai, quand il y en a une.
  finEssai  DateTime? @db.Date

  /// Salaire brut mensuel.
  ///
  /// La donnée la plus sensible du dossier : elle se lit derrière une capacité
  /// à part (« rh.remuneration »), et non avec le reste de la fiche. Le même
  /// principe que le prix d'achat d'une vente, que le commercial ne voit pas.
  salaireBrutMensuel Decimal? @db.Decimal(18, 2)

  /// Quotité travaillée, 100 pour un temps plein.
  tempsPct Int @default(100)

  note String?

  estDemo Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeId])
  @@index([fin])
  @@index([estDemo])
}

/// Motif d'une absence.
///
/// Liste fermée, contrairement aux activités : le motif décide si l'absence
/// consomme le solde de congés, et une valeur libre ne permettrait pas de
/// trancher. Les cas particuliers se précisent dans le motif écrit.
enum TypeAbsence {
  /// Seul type qui décompte du solde annuel.
  CONGE_ANNUEL

  MALADIE
  MATERNITE
  PATERNITE
  SANS_SOLDE
  EVENEMENT_FAMILIAL
  AUTORISATION_EXCEPTIONNELLE
  AUTRE
}

/// État d'une demande dans le circuit de validation.
enum StatutAbsence {
  /// Posée, en attente du manager.
  SOUMISE

  /// Le manager a donné son accord, la RH doit encore vérifier le solde et
  /// les règles.
  VALIDEE_MANAGER

  /// Accord définitif. Seules ces absences-là décomptent du solde et
  /// apparaissent dans les plannings.
  APPROUVEE

  REFUSEE

  /// Retirée par le demandeur avant décision, ou annulée après accord.
  ANNULEE
}

/// Une demande d'absence et son circuit.
///
/// Deux étapes, manager puis RH : le manager connaît la charge de son équipe,
/// la RH connaît le solde et la règle. Chaque décision garde son auteur et sa
/// date, parce qu'un congé refusé se discute et qu'une décision sans signature
/// ne se discute pas, elle se subit.
model DemandeAbsence {
  id String @id @default(uuid())

  employe   Employe @relation("Demandeur", fields: [employeId], references: [id], onDelete: Cascade)
  employeId String

  type  TypeAbsence
  debut DateTime @db.Date
  fin   DateTime @db.Date

  /// Jours ouvrés décomptés, calculés à la soumission et figés ensuite.
  ///
  /// Figés à dessein : recalculer plus tard ferait bouger un solde déjà
  /// communiqué si la liste des jours fériés change entre-temps.
  joursOuvres Decimal @db.Decimal(5, 1)

  /// Demi-journées aux extrémités : partir un vendredi midi est courant, et
  /// l'arrondir au jour plein fait perdre un demi-jour à quelqu'un.
  demiDebut Boolean @default(false)
  demiFin   Boolean @default(false)

  motif String?

  statut StatutAbsence @default(SOUMISE)

  valideeManagerParNom String?
  valideeManagerLe     DateTime?
  valideeRhParNom      String?
  valideeRhLe          DateTime?
  decideeParNom        String?
  motifDecision        String?

  estDemo Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeId, debut])
  @@index([statut])
  @@index([estDemo])
}

/// Correction manuelle d'un solde de congés.
///
/// Les droits se calculent à partir de l'ancienneté et des absences prises,
/// mais la réalité déborde toujours du calcul : un reliquat reporté de
/// l'exercice précédent, un rachat, une régularisation d'entrée en cours
/// d'année. Plutôt que de laisser la RH forcer un solde sans trace, chaque
/// écart est une ligne datée, motivée et signée.
model AjustementConge {
  id String @id @default(uuid())

  employe   Employe @relation(fields: [employeId], references: [id], onDelete: Cascade)
  employeId String

  /// Exercice concerné, en année civile.
  annee Int

  /// Positif pour un report ou un octroi, négatif pour une reprise.
  jours Decimal @db.Decimal(5, 1)

  motif      String
  saisiParNom String

  estDemo Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([employeId, annee])
  @@index([estDemo])
}


// ==========================================================================
// Pipeline commercial
// ==========================================================================

/// Étape d'une opportunité dans le cycle de vente.
///
/// Liste fermée, contrairement aux activités des feuilles de temps : l'étape
/// commande les colonnes du tableau, la probabilité de conclusion et les
/// statistiques de transformation. Une valeur libre rendrait tout cela
/// incalculable.
///
/// L'ordre de déclaration est celui du cycle, et il sert à ordonner les
/// colonnes : le modifier réordonne le tableau.
enum EtapePipeline {
  /// Une piste identifiée, dont on ne sait pas encore si elle mène quelque part.
  NOUVELLE

  /// Le besoin est compris et le client a les moyens : l'affaire mérite du temps.
  QUALIFIEE

  /// Un devis est parti. Chez EasyTech il sort de Zoho.
  DEVIS_ENVOYE

  /// Le client discute le prix ou le périmètre. La signature se joue ici.
  NEGOCIATION

  /// Signée. L'opportunité reste au tableau pour que le commercial voie ce
  /// qu'il a conclu dans la période, puis se range avec le temps.
  GAGNEE

  /// Perdue. Ne figure dans aucune colonne : une colonne de perdues se remplit
  /// sans fin et chasse de l'écran celles qui appellent une action. Elles se
  /// consultent à part, et c'est là qu'on analyse les motifs.
  PERDUE
}

/// Degré d'urgence, posé par le commercial.
///
/// Distinct de la probabilité, qui découle de l'étape : une affaire peut être
/// très probable et sans urgence, ou l'inverse.
enum PrioriteOpportunite {
  BASSE
  MOYENNE
  HAUTE
}

/// Une affaire en cours, avant qu'elle ne devienne une commande.
///
/// Le reste de l'outil ne connaît que les ventes conclues. Une vente dit ce qui
/// s'est passé ; une opportunité dit ce qui est en train de se jouer, et c'est
/// la seule matière sur laquelle un commercial peut encore agir.
///
/// Elle n'entre dans aucun chiffre d'affaires ni dans aucune commission tant
/// qu'elle n'est pas devenue une commande : une affaire espérée n'est pas une
/// affaire faite, et mélanger les deux donnerait un tableau de bord qui
/// promet ce qui n'existe pas.
model Opportunite {
  id String @id @default(uuid())

  /// Ce dont il s'agit, en une ligne. « Renouvellement du parc de serveurs ».
  titre String

  /// Le client ou prospect concerné. Le nom double la relation pour que
  /// l'affaire reste lisible si la fiche disparaît.
  client    Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId  String?
  clientNom String

  /// Le commercial qui la suit. Chacun ne voit que les siennes.
  commercial   Utilisateur? @relation("Opportunites", fields: [commercialId], references: [id], onDelete: SetNull)
  commercialId String?
  commercialNom String

  etape    EtapePipeline       @default(NOUVELLE)
  priorite PrioriteOpportunite @default(MOYENNE)

  /// Montant espéré, hors taxes. Une estimation, jamais un engagement.
  montantEstime Decimal @db.Decimal(18, 2)

  /// Matériel ou service, pour estimer la commission que l'affaire produirait.
  nature NatureVente @default(MATERIEL)

  description String?

  /// Date à laquelle on espère conclure. C'est elle qui fait remonter une
  /// affaire en tête de liste quand l'échéance approche.
  clotureEstimeeLe DateTime? @db.Date

  /// Depuis quand l'affaire est dans son étape actuelle.
  ///
  /// Le signal le plus utile d'un pipeline n'est pas le montant, c'est
  /// l'immobilité : une affaire qui n'a pas bougé depuis trois semaines est en
  /// train de se perdre, et rien d'autre ne le dit.
  etapeDepuisLe DateTime @default(now())

  /// Renseignés à la clôture.
  clotureeLe  DateTime?
  motifPerte  String?

  /// Référence du document Zoho né de cette affaire, quand elle est gagnée.
  /// Simple rappel textuel : une commande comporte plusieurs lignes, et une
  /// clé étrangère vers l'une d'elles n'aurait pas de sens.
  referenceCommande String?

  /// Position dans la colonne, pour un ordre choisi à la main. Les affaires ne
  /// se classent pas toujours par montant ni par date : le commercial met en
  /// haut ce qu'il traite aujourd'hui.
  ordre Int @default(0)

  estDemo Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([commercialId, etape])
  @@index([clientId])
  @@index([etape])
  @@index([estDemo])
}

/// Où en est une demande de cotation dans le circuit commercial / PM.
///
/// Quatre états et pas trois : « traitée » dit que le chef de projet a rendu
/// sa cotation, pas que le commercial l'a eue entre les mains. C'est cette
/// dernière confirmation qui fait sortir la demande de la file, et c'est elle
/// qui manquait au fonctionnement actuel, où personne ne savait si un envoi
/// avait été reçu.
enum StatutCotation {
  NON_TRAITEE
  EN_COURS
  TRAITEE
  CLOTUREE
}

/// Qui a déposé la pièce. Le besoin vient du commercial, la cotation du chef
/// de projet : la même table porte les deux, et ce champ dit de quel côté du
/// circuit chaque fichier se lit.
enum OrigineePiece {
  BESOIN
  COTATION
}

/// Une demande de cotation, du commercial vers le chef de projet.
///
/// Le reste de l'outil suit ce qui est vendu ; cette table suit ce qui bloque
/// avant la vente. Le grief des commerciaux n'était pas le délai en soi mais
/// l'absence de trace : une demande partait par message ou de vive voix, et
/// plus rien n'en disait l'état. Chaque transition est donc horodatée, et
/// aucune ne se saisit à la main.
model DemandeCotation {
  id String @id @default(uuid())

  /// Référence lisible, « COT-2026-0014 ». C'est par elle qu'on en parle en
  /// réunion ou dans un message, l'identifiant technique n'étant pas citable.
  reference String @unique

  /// Ce que le client demande, en une ligne.
  objet String

  /// Le contexte utile au chiffrage. La pièce jointe porte le détail, ce champ
  /// porte ce qu'on ne lira pas dans le PDF.
  description String?

  client    Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientId  String?
  clientNom String

  /// Le demandeur. Le nom double la relation pour que la demande reste lisible
  /// si le compte est fermé.
  commercial    Utilisateur? @relation("CotationsDemandees", fields: [commercialId], references: [id], onDelete: SetNull)
  commercialId  String?
  commercialNom String

  statut StatutCotation @default(NON_TRAITEE)

  /// Date de réponse attendue, fixée par le commercial à la soumission.
  ///
  /// Elle est obligatoire, et c'est le cœur du module : sans échéance annoncée,
  /// une file se trie par ancienneté, ce qui fait passer une demande sans
  /// enjeu avant un appel d'offres qui ferme vendredi.
  echeanceLe DateTime @db.Date

  /// Le chef de projet qui s'en est saisi, renseigné à la prise en charge.
  traitePar    Utilisateur? @relation("CotationsTraitees", fields: [traiteParId], references: [id], onDelete: SetNull)
  traiteParId  String?
  traiteParNom String?

  /// Horodatage de chaque passage. Ce sont ces trois dates, et non le statut
  /// seul, qui permettent de mesurer un délai de prise en charge et un délai
  /// de traitement.
  priseEnChargeLe DateTime?
  traiteeLe       DateTime?
  recueLe         DateTime?

  /// Le mot du chef de projet en rendant la cotation : hypothèses retenues,
  /// réserves, validité du prix.
  reponse String?

  /// Révision demandée par le commercial sur une cotation déjà rendue.
  ///
  /// Sans cette issue, un commercial qui reçoit un chiffrage erroné n'a que
  /// deux choix : l'accepter ou laisser pourrir la demande. Le motif est
  /// obligatoire, et c'est lui qui dit au chef de projet ce qu'il doit
  /// reprendre.
  ///
  /// « traiteeLe » n'est pas effacée : la cotation A été rendue une fois, et
  /// l'effacer retirerait du calcul de tenue des délais un dossier qui compte.
  revisionDemandeeLe DateTime?
  motifRevision      String?
  nbRevisions        Int       @default(0)

  pieces PieceCotation[]

  estDemo Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([commercialId, statut])
  @@index([statut, echeanceLe])
  @@index([clientId])
  @@index([estDemo])
}

/// Un fichier attaché à une demande de cotation.
///
/// Le contenu est stocké en base plutôt que sur disque. Ce sont des PDF de
/// quelques centaines de kilo-octets, et les garder en base leur fait suivre
/// la sauvegarde et évite d'avoir à monter un volume persistant sur chaque
/// instance : un volume oublié au déploiement perd les pièces sans rien dire.
model PieceCotation {
  id        String          @id @default(uuid())
  demande   DemandeCotation @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  demandeId String

  origine OrigineePiece

  nomFichier String
  typeMime   String
  taille     Int
  contenu    Bytes

  deposeParNom String
  createdAt    DateTime @default(now())

  @@index([demandeId])
}
