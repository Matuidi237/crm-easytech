# Copier ce fichier en « .env » sur le VPS, puis remplir chaque valeur.
# Ce fichier ne doit jamais être versionné (il est déjà dans .gitignore).

# ---------------------------------------------------------------- Base de données
POSTGRES_USER=crm
POSTGRES_DB=crm
# Générer :  openssl rand -base64 24
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------- Sécurité
# Signature des jetons de session. SANS CETTE VALEUR, le backend retombe sur un
# secret de développement public : n'importe qui pourrait forger un jeton
# d'administrateur. Générer :  openssl rand -hex 32
JWT_SECRET=

# ------------------------------------------------- Premier compte administrateur
# Créé automatiquement au tout premier démarrage, uniquement si la table des
# utilisateurs est vide. Les comptes suivants se créent depuis l'interface.
ADMIN_USERNAME=admin
# Générer le hash (après le premier « docker compose build ») :
#   docker compose run --rm --no-deps backend \
#     node -e "console.log(require('bcryptjs').hashSync(process.argv[1],10))" 'VotreMotDePasse'
ADMIN_PASSWORD_HASH=

# ------------------------------------------------------------- Envoi des emails
# Laisser vides pour conserver le mode simulé : les campagnes sont journalisées
# en base mais aucun email ne quitte le serveur. À renseigner le jour où le
# domaine est vérifié chez Resend.
RESEND_API_KEY=
MAIL_FROM=

# --------------------------------------------------------- Réseau du reverse proxy
# Nom du réseau Docker de Nginx Proxy Manager. Le trouver avec :
#   docker network ls
# C'est souvent « npm_default » ou un réseau créé à la main, par exemple « proxy ».
RESEAU_PROXY=npm_default
